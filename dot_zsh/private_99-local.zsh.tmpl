# export OPENAI_API_KEY="{{`{{ onepasswordRead "op://Personal/OpenAI/credential" }}`}}"
# export GITHUB_TOKEN="{{`{{ onepasswordRead "op://Personal/GitHub PAT/credential" }}`}}"
{{- else -}}
# 1Password CLI not enabled on this machine; put plaintext env in ~/.zshrc.local
{{- end }}

