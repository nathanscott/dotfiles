{{- if (index . "noAdmin") -}}
#!/bin/sh
# User-local install path (no sudo / no admin).
# Installs the minimum needed for a working shell: antidote, mise, starship.
# Everything else (eza, bat, fd, ripgrep, …) degrades gracefully if missing — the
# zsh fragments gate on `command -v` before using each tool.

set -eu

mkdir -p "$HOME/.local/bin"

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# antidote — zsh plugin manager (clone only, no admin)
if [ ! -d "$HOME/.antidote" ]; then
  echo "==> Cloning antidote to ~/.antidote..."
  git clone --depth=1 https://github.com/mattmc3/antidote.git "$HOME/.antidote"
fi

# mise — installs to ~/.local/share/mise + shim at ~/.local/bin/mise
if ! command -v mise >/dev/null 2>&1; then
  echo "==> Installing mise (user-local)..."
  curl -fsSL https://mise.run | sh
fi

# starship — install binary into ~/.local/bin
if ! command -v starship >/dev/null 2>&1; then
  echo "==> Installing starship to ~/.local/bin..."
  curl -sS https://starship.rs/install.sh | sh -s -- -b "$HOME/.local/bin" -y
fi

echo "==> User-local bootstrap done. Other tools (eza/bat/fd/rg/fzf/atuin/gh) are optional —"
echo "    install them yourself if/when you can. The shell will work without them."
{{- end -}}
