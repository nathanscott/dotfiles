# ~/.zshenv — sourced for ALL zsh invocations (login, interactive, scripts).
# Keep this fast and minimal: PATH only.

# Homebrew (Apple Silicon first, Intel fallback)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# User-local bins (chezmoi, mise shims, pip --user, etc.)
typeset -U path
path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  $path
)
export PATH

# Default editor — prefer VS Code (Homebrew-installed `code` symlink; no path-with-spaces
# headaches and won't be hijacked because Homebrew's prefix is earlier in PATH than /usr/local).
if [ -x /opt/homebrew/bin/code ]; then
  export EDITOR='/opt/homebrew/bin/code --wait'
  export VISUAL="$EDITOR"
elif command -v code >/dev/null 2>&1; then
  export EDITOR='code --wait'
  export VISUAL='code --wait'
elif command -v nvim >/dev/null 2>&1; then
  export EDITOR='nvim'
  export VISUAL='nvim'
else
  export EDITOR='vi'
  export VISUAL='vi'
fi

# mise: auto-load .env from the current directory (gated by `mise trust`)
export MISE_ENV_FILE=.env
